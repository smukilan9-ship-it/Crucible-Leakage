# Copy to .env for local use. .env is git-ignored; never commit real keys.

# Featherless. Optional, and only needed to unlock Kimi K3.
FEATHERLESS_API_KEY=

# Gemini is the default provider. Demonstration pool below. Comma-separated, one key per free-tier account.
# These are shared by every visitor, so the daily limit below is what stops a
# single session from spending the whole pool.
CRUCIBLE_GEMINI_KEYS=
CRUCIBLE_GEMINI_DAILY_LIMIT=20

# Bring your own key for a stronger model. Any one of these is enough; the
# interface takes a single field and works out which vendor issued the key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

CRUCIBLE_RECALL_MODEL=gemini-3.7-flash
CRUCIBLE_SHUFFLES=3
